generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model damage_dealt_events {
  id                                                            Int            @id @default(autoincrement())
  match_id                                                      String         @db.VarChar(50)
  timestamp                                                     DateTime       @db.Timestamp(6)
  game_time_seconds                                             Float?
  actor_id                                                      Int?
  recipient_id                                                  Int?
  weapon_id                                                     String         @db.VarChar(200)
  weapon_type                                                   String?        @db.VarChar(100)
  damage_amount                                                 Float
  actor_x                                                       Float
  actor_y                                                       Float
  actor_z                                                       Float
  recipient_x                                                   Float
  recipient_y                                                   Float
  recipient_z                                                   Float
  distance                                                      Float
  zone                                                          Int
  match_players_damage_dealt_events_actor_idTomatch_players     match_players? @relation("damage_dealt_events_actor_idTomatch_players", fields: [actor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  matches                                                       matches        @relation(fields: [match_id], references: [match_id], onDelete: Cascade, onUpdate: NoAction)
  match_players_damage_dealt_events_recipient_idTomatch_players match_players? @relation("damage_dealt_events_recipient_idTomatch_players", fields: [recipient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([actor_id], map: "idx_damage_actor")
  @@index([distance], map: "idx_damage_distance")
  @@index([match_id], map: "idx_damage_match")
  @@index([recipient_id], map: "idx_damage_recipient")
  @@index([game_time_seconds], map: "idx_damage_time")
  @@index([weapon_type], map: "idx_damage_weapon")
  @@index([zone], map: "idx_damage_zone")
}

model elimination_events {
  id                                                           Int           @id @default(autoincrement())
  match_id                                                     String        @db.VarChar(50)
  timestamp                                                    DateTime      @db.Timestamp(6)
  game_time_seconds                                            Float?
  actor_id                                                     Int
  recipient_id                                                 Int
  weapon_id                                                    String        @db.VarChar(200)
  weapon_type                                                  String?       @db.VarChar(100)
  actor_x                                                      Float
  actor_y                                                      Float
  actor_z                                                      Float
  recipient_x                                                  Float
  recipient_y                                                  Float
  recipient_z                                                  Float
  distance                                                     Float
  zone                                                         Int
  match_players_elimination_events_actor_idTomatch_players     match_players @relation("elimination_events_actor_idTomatch_players", fields: [actor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  matches                                                      matches       @relation(fields: [match_id], references: [match_id], onDelete: Cascade, onUpdate: NoAction)
  match_players_elimination_events_recipient_idTomatch_players match_players @relation("elimination_events_recipient_idTomatch_players", fields: [recipient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([actor_id], map: "idx_elim_actor")
  @@index([match_id], map: "idx_elim_match")
  @@index([recipient_id], map: "idx_elim_recipient")
  @@index([zone], map: "idx_elim_zone")
}

model event_windows {
  event_window_id           String                      @id @db.VarChar(100)
  status                    String                      @db.VarChar(32)
  created_at                DateTime                    @db.Timestamp(6)
  last_processing_start     DateTime?                   @db.Timestamp(6)
  last_processed            DateTime?                   @db.Timestamp(6)
  last_failed               DateTime?                   @db.Timestamp(6)
  start_time                DateTime?                   @db.Timestamp(6)
  end_time                  DateTime?                   @db.Timestamp(6)
  total_matches             Int
  processed_matches         Int
  event_id                  String                      @db.VarChar(100)
  tournament_id             String?                     @db.VarChar
  day_index                 Int?
  event_window_players      event_window_players[]
  event_window_team_matches event_window_team_matches[]
  event_window_teams        event_window_teams[]
  events                    events                      @relation(fields: [event_id], references: [event_id], onDelete: NoAction, onUpdate: NoAction)
  matches                   matches[]
}

model match_players {
  id                                                                             Int                          @id @default(autoincrement())
  epic_id                                                                        String                       @db.VarChar(100)
  epic_username                                                                  String                       @db.VarChar(100)
  match_id                                                                       String                       @db.VarChar(50)
  alive_intervals                                                                alive_intervals[]
  assist_events_assist_events_actor_idTomatch_players                            assist_events[]              @relation("assist_events_actor_idTomatch_players")
  assist_events_assist_events_killer_idTomatch_players                           assist_events[]              @relation("assist_events_killer_idTomatch_players")
  assist_events_assist_events_victim_idTomatch_players                           assist_events[]              @relation("assist_events_victim_idTomatch_players")
  build_placed_events                                                            build_placed_events[]
  damage_contribution_events_damage_contribution_events_actor_idTomatch_players  damage_contribution_events[] @relation("damage_contribution_events_actor_idTomatch_players")
  damage_contribution_events_damage_contribution_events_killer_idTomatch_players damage_contribution_events[] @relation("damage_contribution_events_killer_idTomatch_players")
  damage_contribution_events_damage_contribution_events_victim_idTomatch_players damage_contribution_events[] @relation("damage_contribution_events_victim_idTomatch_players")
  damage_dealt_events_damage_dealt_events_actor_idTomatch_players                damage_dealt_events[]        @relation("damage_dealt_events_actor_idTomatch_players")
  damage_dealt_events_damage_dealt_events_recipient_idTomatch_players            damage_dealt_events[]        @relation("damage_dealt_events_recipient_idTomatch_players")
  elimination_events_elimination_events_actor_idTomatch_players                  elimination_events[]         @relation("elimination_events_actor_idTomatch_players")
  elimination_events_elimination_events_recipient_idTomatch_players              elimination_events[]         @relation("elimination_events_recipient_idTomatch_players")
  fire_weapon_events_fire_weapon_events_actor_idTomatch_players                  fire_weapon_events[]         @relation("fire_weapon_events_actor_idTomatch_players")
  fire_weapon_events_fire_weapon_events_hit_player_idTomatch_players             fire_weapon_events[]         @relation("fire_weapon_events_hit_player_idTomatch_players")
  matches                                                                        matches                      @relation(fields: [match_id], references: [match_id], onDelete: Cascade, onUpdate: NoAction)
  reboot_events_reboot_events_rebooted_idTomatch_players                         reboot_events[]              @relation("reboot_events_rebooted_idTomatch_players")
  reboot_events_reboot_events_rebooter_idTomatch_players                         reboot_events[]              @relation("reboot_events_rebooter_idTomatch_players")
  revive_events_revive_events_revived_idTomatch_players                          revive_events[]              @relation("revive_events_revived_idTomatch_players")
  revive_events_revive_events_reviver_idTomatch_players                          revive_events[]              @relation("revive_events_reviver_idTomatch_players")
  shot_attempt_events_shot_attempt_events_actor_idTomatch_players                shot_attempt_events[]        @relation("shot_attempt_events_actor_idTomatch_players")
  shot_attempt_events_shot_attempt_events_recipient_idTomatch_players            shot_attempt_events[]        @relation("shot_attempt_events_recipient_idTomatch_players")

  @@unique([epic_id, match_id], map: "idx_player_epic_match")
  @@index([match_id], map: "idx_player_match")
}

model matches {
  match_id                   String                       @id @db.VarChar(50)
  event_window_id            String                       @db.VarChar(100)
  status                     String                       @db.VarChar(32)
  created_at                 DateTime                     @db.Timestamp(6)
  last_processing_start      DateTime?                    @db.Timestamp(6)
  last_processed             DateTime?                    @db.Timestamp(6)
  last_failed                DateTime?                    @db.Timestamp(6)
  event_id                   String?                      @db.VarChar(100)
  map_path                   String?                      @db.VarChar
  mode_id                    String?                      @db.VarChar(50)
  start_time                 DateTime?                    @db.Timestamp(6)
  end_time                   DateTime?                    @db.Timestamp(6)
  gamemode                   String?                      @db.VarChar(100)
  duration                   Unsupported("interval")?
  player_count               Int?
  build_major                Int?
  build_minor                Int?
  session_id                 String                       @db.VarChar(50)
  alive_intervals            alive_intervals[]
  assist_events              assist_events[]
  build_placed_events        build_placed_events[]
  damage_contribution_events damage_contribution_events[]
  damage_dealt_events        damage_dealt_events[]
  elimination_events         elimination_events[]
  fire_weapon_events         fire_weapon_events[]
  match_players              match_players[]
  match_stat_status          match_stat_status[]
  match_weapons              match_weapons[]
  event_windows              event_windows                @relation(fields: [event_window_id], references: [event_window_id], onDelete: NoAction, onUpdate: NoAction)
  reboot_events              reboot_events[]
  revive_events              revive_events[]
  shot_attempt_events        shot_attempt_events[]

  @@index([session_id], map: "idx_match_session")
}

model weapons {
  id                    String   @id @db.VarChar(200)
  name                  String?  @db.VarChar(200)
  description           String?  @db.VarChar(1000)
  weapon_type           String?  @db.VarChar(100)
  rarity                String?  @db.VarChar(50)
  ammo                  String?  @db.VarChar(100)
  gameplay_tags         Json?    @db.Json
  image_key             String?  @db.VarChar(300)
  small_image_key       String?  @db.VarChar(300)
  image_url             String?  @db.VarChar(500)
  small_image_url       String?  @db.VarChar(500)
  dmg_pb                Float?
  firing_rate           Float?
  clip_size             Int?
  reload_time           Float?
  bullets_per_cartridge Int?
  spread                Float?
  spread_downsights     Float?
  damage_zone_critical  Float?
  first_seen_at         DateTime @db.Timestamp(6)
  last_seen_at          DateTime @db.Timestamp(6)

  @@index([weapon_type], map: "idx_weapon_type")
  @@index([rarity], map: "idx_weapon_rarity")
}

model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}

model events {
  event_id      String          @id @db.VarChar(100)
  region_code   String?         @db.VarChar(4)
  season_code   String?         @db.VarChar(4)
  image_key     String?         @db.VarChar
  event_windows event_windows[]
}

model tournaments {
  tournament_id String  @id @db.VarChar(100)
  title         String? @db.VarChar(200)
  season_code   String? @db.VarChar(4)
}

model fire_weapon_events {
  id                                                            Int            @id @default(autoincrement())
  match_id                                                      String         @db.VarChar(50)
  timestamp                                                     DateTime       @db.Timestamp(6)
  game_time_seconds                                             Float?
  actor_id                                                      Int
  weapon_id                                                     String         @db.VarChar(200)
  zone                                                          Int?
  damage                                                        Float
  actual_damage                                                 Float
  harvest                                                       Boolean
  hit_player                                                    Boolean
  hit_critical                                                  Boolean
  hit_player_build                                              Boolean
  hit_fatal                                                     Boolean
  hit_shield                                                    Boolean
  hit_ballistic                                                 Boolean
  destroyed_shield                                              Boolean
  hit_player_id                                                 Int?
  hit_result                                                    String?        @db.VarChar(50)
  hit_actor_id                                                  Int?
  end_x                                                         Float?
  end_y                                                         Float?
  end_z                                                         Float?
  item_entry_guid                                               String?        @db.VarChar(100)
  actor_x                                                       Float?
  actor_y                                                       Float?
  actor_z                                                       Float?
  distance                                                      Float?
  match_players_fire_weapon_events_actor_idTomatch_players      match_players  @relation("fire_weapon_events_actor_idTomatch_players", fields: [actor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  match_players_fire_weapon_events_hit_player_idTomatch_players match_players? @relation("fire_weapon_events_hit_player_idTomatch_players", fields: [hit_player_id], references: [id], onUpdate: NoAction)
  matches                                                       matches        @relation(fields: [match_id], references: [match_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([actor_id], map: "idx_fwe_actor")
  @@index([hit_player_id], map: "idx_fwe_hit_player")
  @@index([match_id], map: "idx_fwe_match")
  @@index([game_time_seconds], map: "idx_fwe_time")
  @@index([weapon_id], map: "idx_fwe_weapon")
  @@index([zone], map: "idx_fwe_zone")
}

model match_weapons {
  id          Int     @id @default(autoincrement())
  match_id    String  @db.VarChar(50)
  weapon_id   String  @db.VarChar(200)
  weapon_type String? @db.VarChar(100)
  matches     matches @relation(fields: [match_id], references: [match_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([weapon_id, match_id], map: "idx_match_weapon_unique")
  @@index([match_id], map: "idx_match_weapon_match")
  @@index([weapon_id], map: "idx_match_weapon_weapon")
}

model maps {
  build_major    Int
  build_minor    Int
  mode_id        String   @db.VarChar(50)
  image_key      String?  @db.VarChar(300)
  definition_key String?  @db.VarChar(300)
  synced_at      DateTime @db.Timestamp(6)

  @@id([build_major, build_minor, mode_id])
  @@index([build_major, build_minor], map: "idx_map_build")
}

model damage_contribution_events {
  id                                                                Int           @id @default(autoincrement())
  match_id                                                          String        @db.VarChar(50)
  timestamp                                                         DateTime      @db.Timestamp(6)
  game_time_seconds                                                 Float?
  actor_id                                                          Int
  victim_id                                                         Int
  killer_id                                                         Int
  damage_amount                                                     Float
  match_players_damage_contribution_events_actor_idTomatch_players  match_players @relation("damage_contribution_events_actor_idTomatch_players", fields: [actor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  match_players_damage_contribution_events_killer_idTomatch_players match_players @relation("damage_contribution_events_killer_idTomatch_players", fields: [killer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  matches                                                           matches       @relation(fields: [match_id], references: [match_id], onDelete: Cascade, onUpdate: NoAction)
  match_players_damage_contribution_events_victim_idTomatch_players match_players @relation("damage_contribution_events_victim_idTomatch_players", fields: [victim_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([actor_id], map: "idx_dce_actor")
  @@index([killer_id], map: "idx_dce_killer")
  @@index([match_id], map: "idx_dce_match")
  @@index([game_time_seconds], map: "idx_dce_time")
  @@index([victim_id], map: "idx_dce_victim")
}

model assist_events {
  id                                                   Int           @id @default(autoincrement())
  match_id                                             String        @db.VarChar(50)
  timestamp                                            DateTime      @db.Timestamp(6)
  game_time_seconds                                    Float?
  actor_id                                             Int
  victim_id                                            Int
  killer_id                                            Int
  match_players_assist_events_actor_idTomatch_players  match_players @relation("assist_events_actor_idTomatch_players", fields: [actor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  match_players_assist_events_killer_idTomatch_players match_players @relation("assist_events_killer_idTomatch_players", fields: [killer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  matches                                              matches       @relation(fields: [match_id], references: [match_id], onDelete: Cascade, onUpdate: NoAction)
  match_players_assist_events_victim_idTomatch_players match_players @relation("assist_events_victim_idTomatch_players", fields: [victim_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([actor_id], map: "idx_assist_actor")
  @@index([killer_id], map: "idx_assist_killer")
  @@index([match_id], map: "idx_assist_match")
  @@index([game_time_seconds], map: "idx_assist_time")
  @@index([victim_id], map: "idx_assist_victim")
}

model shot_attempt_events {
  id                                                            Int           @id @default(autoincrement())
  match_id                                                      String        @db.VarChar(50)
  timestamp                                                     DateTime      @db.Timestamp(6)
  game_time_seconds                                             Float?
  actor_id                                                      Int
  recipient_id                                                  Int
  weapon_id                                                     String?       @db.VarChar(200)
  direct_hit                                                    Boolean
  passing_distance                                              Float
  match_players_shot_attempt_events_actor_idTomatch_players     match_players @relation("shot_attempt_events_actor_idTomatch_players", fields: [actor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  matches                                                       matches       @relation(fields: [match_id], references: [match_id], onDelete: Cascade, onUpdate: NoAction)
  match_players_shot_attempt_events_recipient_idTomatch_players match_players @relation("shot_attempt_events_recipient_idTomatch_players", fields: [recipient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([actor_id], map: "idx_shotatt_actor")
  @@index([match_id], map: "idx_shotatt_match")
  @@index([recipient_id], map: "idx_shotatt_recipient")
  @@index([game_time_seconds], map: "idx_shotatt_time")
  @@index([weapon_id], map: "idx_shotatt_weapon")
}

model match_stat_status {
  match_id       String    @db.VarChar(50)
  stat_name      String    @db.VarChar(50)
  parser_version Int?
  status         String    @db.VarChar(32)
  last_processed DateTime? @db.Timestamp(6)
  last_failed    DateTime? @db.Timestamp(6)
  matches        matches   @relation(fields: [match_id], references: [match_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([match_id, stat_name])
  @@index([stat_name], map: "idx_mss_stat")
}

model reboot_events {
  id                                                     Int            @id @default(autoincrement())
  match_id                                               String         @db.VarChar(50)
  timestamp                                              DateTime       @db.Timestamp(6)
  game_time_seconds                                      Float?
  rebooted_id                                            Int
  rebooter_id                                            Int?
  matches                                                matches        @relation(fields: [match_id], references: [match_id], onDelete: Cascade, onUpdate: NoAction)
  match_players_reboot_events_rebooted_idTomatch_players match_players  @relation("reboot_events_rebooted_idTomatch_players", fields: [rebooted_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  match_players_reboot_events_rebooter_idTomatch_players match_players? @relation("reboot_events_rebooter_idTomatch_players", fields: [rebooter_id], references: [id], onUpdate: NoAction)

  @@index([match_id], map: "idx_reboot_match")
  @@index([rebooted_id], map: "idx_reboot_rebooted")
  @@index([rebooter_id], map: "idx_reboot_rebooter")
  @@index([game_time_seconds], map: "idx_reboot_time")
}

model alive_intervals {
  id            Int           @id @default(autoincrement())
  match_id      String        @db.VarChar(50)
  player_id     Int
  start_seconds Float
  end_seconds   Float
  matches       matches       @relation(fields: [match_id], references: [match_id], onDelete: Cascade, onUpdate: NoAction)
  match_players match_players @relation(fields: [player_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([end_seconds], map: "idx_alive_end")
  @@index([match_id], map: "idx_alive_match")
  @@index([player_id], map: "idx_alive_player")
  @@index([start_seconds], map: "idx_alive_start")
}

model revive_events {
  id                                                    Int            @id @default(autoincrement())
  match_id                                              String         @db.VarChar(50)
  timestamp                                             DateTime       @db.Timestamp(6)
  game_time_seconds                                     Float?
  revived_id                                            Int
  reviver_id                                            Int?
  matches                                               matches        @relation(fields: [match_id], references: [match_id], onDelete: Cascade, onUpdate: NoAction)
  match_players_revive_events_revived_idTomatch_players match_players  @relation("revive_events_revived_idTomatch_players", fields: [revived_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  match_players_revive_events_reviver_idTomatch_players match_players? @relation("revive_events_reviver_idTomatch_players", fields: [reviver_id], references: [id], onUpdate: NoAction)

  @@index([match_id], map: "idx_revive_match")
  @@index([revived_id], map: "idx_revive_revived")
  @@index([reviver_id], map: "idx_revive_reviver")
  @@index([game_time_seconds], map: "idx_revive_time")
}

model build_placed_events {
  id                Int           @id @default(autoincrement())
  match_id          String        @db.VarChar(50)
  timestamp         DateTime      @db.Timestamp(6)
  game_time_seconds Float?
  builder_id        Int
  build_type        String?       @db.VarChar(200)
  location_x        Float?
  location_y        Float?
  location_z        Float?
  build_actor_id    Int?
  edited_actor_id   Int?
  match_players     match_players @relation(fields: [builder_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  matches           matches       @relation(fields: [match_id], references: [match_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([builder_id], map: "idx_buildplaced_builder")
  @@index([match_id], map: "idx_buildplaced_match")
  @@index([game_time_seconds], map: "idx_buildplaced_time")
  @@index([build_type], map: "idx_buildplaced_type")
}

model event_window_team_matches {
  id                   Int           @id @default(autoincrement())
  event_window_id      String        @db.VarChar(100)
  team_id              String        @db.VarChar(200)
  session_id           String        @db.VarChar(50)
  game_number          Int
  end_time             DateTime      @db.Timestamp(6)
  placement            Int?
  team_elims           Int
  victory_royale       Boolean
  time_alive           Int?
  placement_tiebreaker Int?
  placement_points     Int
  elim_points          Int
  total_points         Int
  event_windows        event_windows @relation(fields: [event_window_id], references: [event_window_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([event_window_id, team_id, session_id], map: "idx_ewtm_window_team_session")
  @@index([session_id], map: "idx_ewtm_session")
  @@index([team_id], map: "idx_ewtm_team")
  @@index([event_window_id], map: "idx_ewtm_window")
}

model event_window_teams {
  id              Int           @id @default(autoincrement())
  event_window_id String        @db.VarChar(100)
  team_id         String        @db.VarChar(200)
  team_key        String        @db.VarChar(200)
  final_rank      Int
  final_points    Int
  final_score     BigInt
  percentile      Float
  matches         Int
  wins            Int
  kills           Int
  event_windows   event_windows @relation(fields: [event_window_id], references: [event_window_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([event_window_id, team_id], map: "idx_ewt_window_team")
  @@index([team_key], map: "idx_ewt_team_key")
  @@index([event_window_id], map: "idx_ewt_window")
}

model event_window_players {
  id              Int           @id @default(autoincrement())
  event_window_id String        @db.VarChar(100)
  epic_id         String        @db.VarChar(100)
  epic_username   String        @db.VarChar(100)
  flag_token      String?       @db.VarChar(100)
  event_windows   event_windows @relation(fields: [event_window_id], references: [event_window_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([event_window_id, epic_id], map: "idx_ewp_window_epic")
  @@index([epic_id], map: "idx_ewp_epic")
  @@index([event_window_id], map: "idx_ewp_window")
}
